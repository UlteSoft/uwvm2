;; Core3 mixed selected address types, bounded min/max and independent memory sizes.
(module $pages
 (memory $m32 1 2)
 (memory $m64 i64 2 3)
 (func (export "size32") (result i32) memory.size $m32)
 (func (export "size64") (result i64) memory.size $m64)
 (func (export "grow32") (param i32) (result i32) local.get 0 memory.grow $m32)
 (func (export "grow64") (param i64) (result i64) local.get 0 memory.grow $m64)
 (func (export "unreachable_pages") unreachable memory.size $m64 drop memory.grow $m64 drop))
(assert_return (invoke $pages "size32") (i32.const 1))
(assert_return (invoke $pages "size64") (i64.const 2))
(assert_return (invoke $pages "grow32" (i32.const 0)) (i32.const 1))
(assert_return (invoke $pages "grow64" (i64.const 0)) (i64.const 2))
(assert_return (invoke $pages "grow32" (i32.const 1)) (i32.const 1))
(assert_return (invoke $pages "size64") (i64.const 2))
(assert_return (invoke $pages "size32") (i32.const 2))
(assert_return (invoke $pages "grow64" (i64.const 1)) (i64.const 2))
(assert_return (invoke $pages "size64") (i64.const 3))
(assert_return (invoke $pages "grow32" (i32.const 1)) (i32.const -1))
(assert_return (invoke $pages "grow64" (i64.const 1)) (i64.const -1))
(assert_return (invoke $pages "grow32" (i32.const -1)) (i32.const -1))
(assert_return (invoke $pages "grow64" (i64.const -1)) (i64.const -1))
(assert_return (invoke $pages "size32") (i32.const 2))
(assert_return (invoke $pages "size64") (i64.const 3))
(assert_invalid (module (memory i64 1 2) (func (result i32) memory.size)) "type mismatch")
(assert_invalid (module (memory i64 1 2) (func i32.const 1 memory.grow drop)) "type mismatch")
(assert_invalid (module (memory 1 2) (func i64.const 1 memory.grow drop)) "type mismatch")
(assert_invalid (module (memory i64 1 2) (func (result i32) i64.const 1 memory.grow)) "type mismatch")
(assert_invalid (module (memory i64 1 2) (func memory.size 1 drop)) "unknown memory")
(assert_invalid (module (memory i64 1 2) (func i64.const 0 memory.grow 1 drop)) "unknown memory")
(assert_invalid (module (memory i64 1 2) (func unreachable f32.const 0 memory.grow drop)) "type mismatch")
