;; New Core 3 GC/nondefaultable locals, typed blocks and tail-call syntax
;; plus all18 i32 op edge bits. Source only until real WAST/CLI execution.
(module
  (type $box (struct (field i32)))
  (type $sig (func (param i32) (result i32)))
  (func $callee (type $sig) local.get 0 i32.const 2 i32.add)
  (func (export "i32.clz") (param i32) (result i32) local.get 0 i32.clz)
  (func (export "i32.ctz") (param i32) (result i32) local.get 0 i32.ctz)
  (func (export "i32.popcnt") (param i32) (result i32) local.get 0 i32.popcnt)
  (func (export "i32.add") (param i32 i32) (result i32) local.get 0 local.get 1 i32.add)
  (func (export "i32.sub") (param i32 i32) (result i32) local.get 0 local.get 1 i32.sub)
  (func (export "i32.mul") (param i32 i32) (result i32) local.get 0 local.get 1 i32.mul)
  (func (export "i32.div_s") (param i32 i32) (result i32) local.get 0 local.get 1 i32.div_s)
  (func (export "i32.div_u") (param i32 i32) (result i32) local.get 0 local.get 1 i32.div_u)
  (func (export "i32.rem_s") (param i32 i32) (result i32) local.get 0 local.get 1 i32.rem_s)
  (func (export "i32.rem_u") (param i32 i32) (result i32) local.get 0 local.get 1 i32.rem_u)
  (func (export "i32.and") (param i32 i32) (result i32) local.get 0 local.get 1 i32.and)
  (func (export "i32.or") (param i32 i32) (result i32) local.get 0 local.get 1 i32.or)
  (func (export "i32.xor") (param i32 i32) (result i32) local.get 0 local.get 1 i32.xor)
  (func (export "i32.shl") (param i32 i32) (result i32) local.get 0 local.get 1 i32.shl)
  (func (export "i32.shr_s") (param i32 i32) (result i32) local.get 0 local.get 1 i32.shr_s)
  (func (export "i32.shr_u") (param i32 i32) (result i32) local.get 0 local.get 1 i32.shr_u)
  (func (export "i32.rotl") (param i32 i32) (result i32) local.get 0 local.get 1 i32.rotl)
  (func (export "i32.rotr") (param i32 i32) (result i32) local.get 0 local.get 1 i32.rotr)
  (func (export "gc_nonnull_local") (result i32) (local $b (ref $box))
    i32.const 42 struct.new $box local.set $b
    block (result i32) local.get $b struct.get $box 0 i32.const 0 i32.add end)
  (func (export "typed_block") (result i32)
    i32.const 6 i32.const 7 block (param i32 i32) (result i32) i32.mul end)
  (func (export "tail_numeric") (result i32) i32.const 40 return_call $callee)
)
(assert_return (invoke "i32.clz" (i32.const 0)) (i32.const 32))
(assert_return (invoke "i32.clz" (i32.const 1)) (i32.const 31))
(assert_return (invoke "i32.clz" (i32.const -2147483648)) (i32.const 0))
(assert_return (invoke "i32.ctz" (i32.const 0)) (i32.const 32))
(assert_return (invoke "i32.ctz" (i32.const 1)) (i32.const 0))
(assert_return (invoke "i32.ctz" (i32.const -2147483648)) (i32.const 31))
(assert_return (invoke "i32.popcnt" (i32.const 0)) (i32.const 0))
(assert_return (invoke "i32.popcnt" (i32.const -1)) (i32.const 32))
(assert_return (invoke "i32.popcnt" (i32.const 1431655765)) (i32.const 16))
(assert_return (invoke "i32.add" (i32.const -1) (i32.const 1)) (i32.const 0))
(assert_return (invoke "i32.add" (i32.const -2147483648) (i32.const -2147483648)) (i32.const 0))
(assert_return (invoke "i32.add" (i32.const 25) (i32.const 17)) (i32.const 42))
(assert_return (invoke "i32.sub" (i32.const 0) (i32.const 1)) (i32.const -1))
(assert_return (invoke "i32.sub" (i32.const -2147483648) (i32.const 1)) (i32.const 2147483647))
(assert_return (invoke "i32.sub" (i32.const 59) (i32.const 17)) (i32.const 42))
(assert_return (invoke "i32.mul" (i32.const -2147483648) (i32.const 2)) (i32.const 0))
(assert_return (invoke "i32.mul" (i32.const -1) (i32.const -1)) (i32.const 1))
(assert_return (invoke "i32.mul" (i32.const 6) (i32.const 7)) (i32.const 42))
(assert_return (invoke "i32.div_s" (i32.const -84) (i32.const -2)) (i32.const 42))
(assert_return (invoke "i32.div_s" (i32.const -84) (i32.const 2)) (i32.const -42))
(assert_return (invoke "i32.div_s" (i32.const -2147483648) (i32.const 1)) (i32.const -2147483648))
(assert_return (invoke "i32.div_u" (i32.const -1) (i32.const 3)) (i32.const 1431655765))
(assert_return (invoke "i32.div_u" (i32.const 84) (i32.const 2)) (i32.const 42))
(assert_return (invoke "i32.div_u" (i32.const -2147483648) (i32.const 2)) (i32.const 1073741824))
(assert_return (invoke "i32.rem_s" (i32.const -2147483648) (i32.const -1)) (i32.const 0))
(assert_return (invoke "i32.rem_s" (i32.const -85) (i32.const 2)) (i32.const -1))
(assert_return (invoke "i32.rem_s" (i32.const 85) (i32.const -2)) (i32.const 1))
(assert_return (invoke "i32.rem_u" (i32.const -1) (i32.const 2)) (i32.const 1))
(assert_return (invoke "i32.rem_u" (i32.const 85) (i32.const 2)) (i32.const 1))
(assert_return (invoke "i32.rem_u" (i32.const -2147483648) (i32.const 3)) (i32.const 2))
(assert_return (invoke "i32.and" (i32.const 85) (i32.const 51)) (i32.const 17))
(assert_return (invoke "i32.and" (i32.const -1) (i32.const 42)) (i32.const 42))
(assert_return (invoke "i32.or" (i32.const 85) (i32.const 51)) (i32.const 119))
(assert_return (invoke "i32.or" (i32.const 0) (i32.const 42)) (i32.const 42))
(assert_return (invoke "i32.xor" (i32.const 85) (i32.const 51)) (i32.const 102))
(assert_return (invoke "i32.xor" (i32.const -1) (i32.const -1)) (i32.const 0))
(assert_return (invoke "i32.shl" (i32.const 1) (i32.const 32)) (i32.const 1))
(assert_return (invoke "i32.shl" (i32.const 1) (i32.const 33)) (i32.const 2))
(assert_return (invoke "i32.shl" (i32.const -2147483648) (i32.const 1)) (i32.const 0))
(assert_return (invoke "i32.shr_s" (i32.const -2147483648) (i32.const 32)) (i32.const -2147483648))
(assert_return (invoke "i32.shr_s" (i32.const -2147483648) (i32.const 33)) (i32.const -1073741824))
(assert_return (invoke "i32.shr_u" (i32.const -2147483648) (i32.const 32)) (i32.const -2147483648))
(assert_return (invoke "i32.shr_u" (i32.const -2147483648) (i32.const 33)) (i32.const 1073741824))
(assert_return (invoke "i32.rotl" (i32.const -2147483647) (i32.const 0)) (i32.const -2147483647))
(assert_return (invoke "i32.rotl" (i32.const -2147483647) (i32.const 1)) (i32.const 3))
(assert_return (invoke "i32.rotl" (i32.const 1) (i32.const 33)) (i32.const 2))
(assert_return (invoke "i32.rotr" (i32.const -2147483647) (i32.const 0)) (i32.const -2147483647))
(assert_return (invoke "i32.rotr" (i32.const -2147483647) (i32.const 1)) (i32.const -1073741824))
(assert_return (invoke "i32.rotr" (i32.const 1) (i32.const 33)) (i32.const -2147483648))
(assert_return (invoke "gc_nonnull_local") (i32.const 42))
(assert_return (invoke "typed_block") (i32.const 42))
(assert_return (invoke "tail_numeric") (i32.const 42))
(assert_trap (invoke "i32.div_s" (i32.const 1) (i32.const 0)) "integer divide by zero")
(assert_trap (invoke "i32.div_u" (i32.const 1) (i32.const 0)) "integer divide by zero")
(assert_trap (invoke "i32.rem_s" (i32.const 1) (i32.const 0)) "integer divide by zero")
(assert_trap (invoke "i32.rem_u" (i32.const 1) (i32.const 0)) "integer divide by zero")
(assert_trap (invoke "i32.div_s" (i32.const -2147483648) (i32.const -1)) "integer overflow")
;; Empty polymorphic operands remain valid; these functions must not execute.
(module (func (export "_start"))
  (func unreachable i32.clz drop)
  (func unreachable i32.const 1 i32.add drop)
  ;; Child entry resets validation polymorphism, but physical IR stays dead.
  (func unreachable block i32.const 1 i32.clz drop
    loop i32.const 1 i32.const 2 i32.add drop end end))
;; Concrete values remain typed even above an unreachable current-frame base.
(assert_invalid (module (func (export "_start") unreachable i64.const 1 i32.clz drop)) "type mismatch")
(assert_invalid (module (func (export "_start") unreachable ref.as_non_null i32.const 1 i32.add drop)) "type mismatch")
(assert_invalid (module (func (export "_start") ref.null none i32.clz drop)) "type mismatch")
(assert_invalid (module (type $box (struct (field i32))) (func (export "_start")
  i32.const 1 struct.new $box i32.const 2 i32.add drop)) "type mismatch")
;; An available mismatched RHS cannot mask fixed arity underflow.
(assert_invalid (module (func (export "_start") i64.const 1 i32.add drop)) "type mismatch")
(assert_invalid (module (func (export "_start") i32.const 1 block i32.clz drop end)) "type mismatch")
