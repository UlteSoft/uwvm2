(module
  (type $utf16 (array i16))
  (type $chars (array (mut i32)))
  (data $text "\61\00\62\00\63\00")
  (func $copy (param $dst (ref $chars)) (param $d i32)
    (param $src (ref $utf16)) (param $s i32) (param $n i32)
    (local $end i32) (local $i i32) (local $j i32)
    (local.set $end (i32.add (local.get $s) (local.get $n)))
    (local.get $s)
    (local.get $d)
    (loop $again (param i32 i32)
      (local.set $j) (local.set $i)
      (if (i32.lt_s (local.get $i) (local.get $end))
        (then
          (array.set $chars (local.get $dst) (local.get $j)
            (array.get_u $utf16 (local.get $src) (local.get $i)))
          (i32.add (local.get $i) (i32.const 1))
          (i32.add (local.get $j) (i32.const 1))
          (br $again)))))
  (func (export "_start")
    (local $source (ref $utf16)) (local $target (ref $chars))
    (local.set $source (array.new_data $utf16 $text (i32.const 0) (i32.const 3)))
    (local.set $target (array.new_default $chars (i32.const 4)))
    (call $copy (local.get $target) (i32.const 1) (local.get $source) (i32.const 0) (i32.const 3))
    (if (i32.ne (array.get $chars (local.get $target) (i32.const 1)) (i32.const 97)) (then unreachable))
    (if (i32.ne (array.get $chars (local.get $target) (i32.const 2)) (i32.const 98)) (then unreachable))
    (if (i32.ne (array.get $chars (local.get $target) (i32.const 3)) (i32.const 99)) (then unreachable))))
