+    // Profile fixture's System.in.read(): a real, blocking, one-byte WASI read.
+    @Unmanaged
+    public static int readStdinByte() {
+        Address buffer = WasiBuffer.getBuffer();
+        IOVec vector = buffer.toStructure();
+        SizeResult result = Address.align(buffer.add(Structure.sizeOf(IOVec.class)), 16).toStructure();
+        Address value = buffer.add(128);
+        vector.buffer = value;
+        vector.bufferLength = 1;
+        result.value = 0;
+        if (Wasi.fdRead(0, vector, 1, result) != ERRNO_SUCCESS || (result.value != 0 && result.value != 1)) {
+            stdinFailure(74);
+        }
+        return result.value == 0 ? -1 : value.getByte() & 255;
+    }
