+    // WASI clockid 1 is CLOCKID_MONOTONIC; timestamps are already nanoseconds.
+    @Unmanaged
+    public static long nanoTime() {
+        LongResult result = WasiBuffer.getBuffer().toStructure();
+        if (Wasi.clockTimeGet(1, 1, result) != ERRNO_SUCCESS) {
+            monotonicClockFailure(70);
+        }
+        return result.value;
+    }
