;; Core3 typed scalar rules: selected addr width, value Bot and reference-only Bot.
(module $scalar (memory $m32 1 1) (memory $m64 i64 1 1)
(func (export "i32_i32") (result i32) i32.const 32 i32.const 0x01234567 i32.store $m32 i32.const 32 i32.load $m32 )
(func (export "i32_i64") (result i64) i32.const 32 i64.const 0x0123456789abcdef i64.store $m32 i32.const 32 i64.load $m32 )
(func (export "i32_f32") (result i32) i32.const 32 f32.const -13.5 f32.store $m32 i32.const 32 f32.load $m32 i32.reinterpret_f32)
(func (export "i32_f64") (result i64) i32.const 32 f64.const -13.5 f64.store $m32 i32.const 32 f64.load $m32 i64.reinterpret_f64)
(func unreachable i32.load $m32 drop)
(func unreachable i64.load $m32 drop)
(func unreachable f32.load $m32 drop)
(func unreachable f64.load $m32 drop)
(func unreachable i32.const 0x01234567 i32.store $m32)
(func unreachable i64.const 0x0123456789abcdef i64.store $m32)
(func unreachable f32.const -13.5 f32.store $m32)
(func unreachable f64.const -13.5 f64.store $m32)
(func (export "i64_i32") (result i32) i64.const 32 i32.const 0x01234567 i32.store $m64 i64.const 32 i32.load $m64 )
(func (export "i64_i64") (result i64) i64.const 32 i64.const 0x0123456789abcdef i64.store $m64 i64.const 32 i64.load $m64 )
(func (export "i64_f32") (result i32) i64.const 32 f32.const -13.5 f32.store $m64 i64.const 32 f32.load $m64 i32.reinterpret_f32)
(func (export "i64_f64") (result i64) i64.const 32 f64.const -13.5 f64.store $m64 i64.const 32 f64.load $m64 i64.reinterpret_f64)
(func unreachable i32.load $m64 drop)
(func unreachable i64.load $m64 drop)
(func unreachable f32.load $m64 drop)
(func unreachable f64.load $m64 drop)
(func unreachable i32.const 0x01234567 i32.store $m64)
(func unreachable i64.const 0x0123456789abcdef i64.store $m64)
(func unreachable f32.const -13.5 f32.store $m64)
(func unreachable f64.const -13.5 f64.store $m64)
)
(assert_return (invoke $scalar "i32_i32") (i32.const 19088743))
(assert_return (invoke $scalar "i32_i64") (i64.const 81985529216486895))
(assert_return (invoke $scalar "i32_f32") (i32.const 3243769856))
(assert_return (invoke $scalar "i32_f64") (i64.const 13847161479280721920))
(assert_return (invoke $scalar "i64_i32") (i32.const 19088743))
(assert_return (invoke $scalar "i64_i64") (i64.const 81985529216486895))
(assert_return (invoke $scalar "i64_f32") (i32.const 3243769856))
(assert_return (invoke $scalar "i64_f64") (i64.const 13847161479280721920))
(assert_invalid (module (memory 1) (func unreachable ref.as_non_null i32.load drop)) "type mismatch")
(assert_invalid (module (memory 1) (func unreachable ref.as_non_null i32.store)) "type mismatch")
(assert_invalid (module (memory 1) (func unreachable ref.as_non_null i32.const 0 i32.store)) "type mismatch")
(assert_invalid (module (memory 1) (func f32.const 0 i32.store)) "type mismatch")
(assert_invalid (module (memory 1) (func i32.const 0 i64.const 0 i32.store)) "type mismatch")
(assert_invalid (module (memory i64 1) (func unreachable ref.as_non_null i32.load drop)) "type mismatch")
(assert_invalid (module (memory i64 1) (func unreachable ref.as_non_null i32.store)) "type mismatch")
(assert_invalid (module (memory i64 1) (func unreachable ref.as_non_null i32.const 0 i32.store)) "type mismatch")
(assert_invalid (module (memory i64 1) (func f32.const 0 i32.store)) "type mismatch")
(assert_invalid (module (memory i64 1) (func i64.const 0 i64.const 0 i32.store)) "type mismatch")
