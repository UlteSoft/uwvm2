;; Core3 same-pass bulk memory: both addr widths and every mixed-copy pair.
(module $bulk
 (memory $m32 1 1)
 (memory $m64 i64 1 1)
 (data $keep "\01\02\03\04\05\06\07\08")
 (data $gone "\01\02\03\04")
 (func (export "i32_fill") (result i32) i32.const 32 i32.const 0x1ab i32.const 4 memory.fill $m32 i32.const 32 i32.load $m32)
 (func (export "i32_init") (result i32) i32.const 64 i32.const 2 i32.const 4 memory.init $m32 $keep i32.const 64 i32.load $m32)
 (func (export "i32_zero_end") (result i32) i32.const 65536 i32.const 77 i32.const 0 memory.fill $m32 i32.const 65536 i32.const 8 i32.const 0 memory.init $m32 $keep i32.const 0)
 (func (export "i32_overlap_right") (result i32) i32.const 96 i64.const 0x0807060504030201 i64.store $m32 i32.const 97 i32.const 96 i32.const 7 memory.copy $m32 $m32 i32.const 97 i32.load $m32)
 (func (export "i32_overlap_left") (result i32) i32.const 96 i64.const 0x0807060504030201 i64.store $m32 i32.const 96 i32.const 97 i32.const 7 memory.copy $m32 $m32 i32.const 96 i32.load $m32)
 (func (export "i32_drop_empty") (result i32) data.drop $gone data.drop $gone i32.const 65536 i32.const 0 i32.const 0 memory.init $m32 $gone i32.const 0)
 (func (export "i32_fill_zero_bad") i32.const 65537 i32.const 0 i32.const 0 memory.fill $m32)
 (func (export "i32_init_source_zero_bad") i32.const 65536 i32.const 9 i32.const 0 memory.init $m32 $keep)
 (func (export "i32_init_dropped_nonempty") data.drop $gone i32.const 0 i32.const 0 i32.const 1 memory.init $m32 $gone)
 (func (export "i64_fill") (result i32) i64.const 32 i32.const 0x1ab i64.const 4 memory.fill $m64 i64.const 32 i32.load $m64)
 (func (export "i64_init") (result i32) i64.const 64 i32.const 2 i32.const 4 memory.init $m64 $keep i64.const 64 i32.load $m64)
 (func (export "i64_zero_end") (result i32) i64.const 65536 i32.const 77 i64.const 0 memory.fill $m64 i64.const 65536 i32.const 8 i32.const 0 memory.init $m64 $keep i32.const 0)
 (func (export "i64_overlap_right") (result i32) i64.const 96 i64.const 0x0807060504030201 i64.store $m64 i64.const 97 i64.const 96 i64.const 7 memory.copy $m64 $m64 i64.const 97 i32.load $m64)
 (func (export "i64_overlap_left") (result i32) i64.const 96 i64.const 0x0807060504030201 i64.store $m64 i64.const 96 i64.const 97 i64.const 7 memory.copy $m64 $m64 i64.const 96 i32.load $m64)
 (func (export "i64_drop_empty") (result i32) data.drop $gone data.drop $gone i64.const 65536 i32.const 0 i32.const 0 memory.init $m64 $gone i32.const 0)
 (func (export "i64_fill_zero_bad") i64.const 65537 i32.const 0 i64.const 0 memory.fill $m64)
 (func (export "i64_init_source_zero_bad") i64.const 65536 i32.const 9 i32.const 0 memory.init $m64 $keep)
 (func (export "i64_init_dropped_nonempty") data.drop $gone i64.const 0 i32.const 0 i32.const 1 memory.init $m64 $gone)
 (func (export "i32_from_i32") (result i32) i32.const 128 i64.const 0x0807060504030201 i64.store $m32 i32.const 160 i32.const 128 i32.const 8 memory.copy $m32 $m32 i32.const 160 i32.load $m32)
 (func (export "i32_from_i32_zero_end") (result i32) i32.const 65536 i32.const 65536 i32.const 0 memory.copy $m32 $m32 i32.const 0)
 (func (export "i32_from_i32_zero_bad_destination") i32.const 65537 i32.const 65536 i32.const 0 memory.copy $m32 $m32)
 (func (export "i32_from_i32_zero_bad_source") i32.const 65536 i32.const 65537 i32.const 0 memory.copy $m32 $m32)
 (func (export "i32_from_i64") (result i32) i64.const 128 i64.const 0x0807060504030201 i64.store $m64 i32.const 160 i64.const 128 i32.const 8 memory.copy $m32 $m64 i32.const 160 i32.load $m32)
 (func (export "i32_from_i64_zero_end") (result i32) i32.const 65536 i64.const 65536 i32.const 0 memory.copy $m32 $m64 i32.const 0)
 (func (export "i32_from_i64_zero_bad_destination") i32.const 65537 i64.const 65536 i32.const 0 memory.copy $m32 $m64)
 (func (export "i32_from_i64_zero_bad_source") i32.const 65536 i64.const 65537 i32.const 0 memory.copy $m32 $m64)
 (func (export "i64_from_i32") (result i32) i32.const 128 i64.const 0x0807060504030201 i64.store $m32 i64.const 160 i32.const 128 i32.const 8 memory.copy $m64 $m32 i64.const 160 i32.load $m64)
 (func (export "i64_from_i32_zero_end") (result i32) i64.const 65536 i32.const 65536 i32.const 0 memory.copy $m64 $m32 i32.const 0)
 (func (export "i64_from_i32_zero_bad_destination") i64.const 65537 i32.const 65536 i32.const 0 memory.copy $m64 $m32)
 (func (export "i64_from_i32_zero_bad_source") i64.const 65536 i32.const 65537 i32.const 0 memory.copy $m64 $m32)
 (func (export "i64_from_i64") (result i32) i64.const 128 i64.const 0x0807060504030201 i64.store $m64 i64.const 160 i64.const 128 i64.const 8 memory.copy $m64 $m64 i64.const 160 i32.load $m64)
 (func (export "i64_from_i64_zero_end") (result i32) i64.const 65536 i64.const 65536 i64.const 0 memory.copy $m64 $m64 i32.const 0)
 (func (export "i64_from_i64_zero_bad_destination") i64.const 65537 i64.const 65536 i64.const 0 memory.copy $m64 $m64)
 (func (export "i64_from_i64_zero_bad_source") i64.const 65536 i64.const 65537 i64.const 0 memory.copy $m64 $m64)
 (func $unreachable_valid unreachable memory.copy $m64 $m32)
)
(assert_return (invoke $bulk "i32_fill") (i32.const 2880154539))
(assert_return (invoke $bulk "i32_init") (i32.const 100992003))
(assert_return (invoke $bulk "i32_zero_end") (i32.const 0))
(assert_return (invoke $bulk "i32_overlap_right") (i32.const 67305985))
(assert_return (invoke $bulk "i32_overlap_left") (i32.const 84148994))
(assert_return (invoke $bulk "i32_drop_empty") (i32.const 0))
(assert_return (invoke $bulk "i64_fill") (i32.const 2880154539))
(assert_return (invoke $bulk "i64_init") (i32.const 100992003))
(assert_return (invoke $bulk "i64_zero_end") (i32.const 0))
(assert_return (invoke $bulk "i64_overlap_right") (i32.const 67305985))
(assert_return (invoke $bulk "i64_overlap_left") (i32.const 84148994))
(assert_return (invoke $bulk "i64_drop_empty") (i32.const 0))
(assert_return (invoke $bulk "i32_from_i32") (i32.const 67305985))
(assert_return (invoke $bulk "i32_from_i32_zero_end") (i32.const 0))
(assert_return (invoke $bulk "i32_from_i64") (i32.const 67305985))
(assert_return (invoke $bulk "i32_from_i64_zero_end") (i32.const 0))
(assert_return (invoke $bulk "i64_from_i32") (i32.const 67305985))
(assert_return (invoke $bulk "i64_from_i32_zero_end") (i32.const 0))
(assert_return (invoke $bulk "i64_from_i64") (i32.const 67305985))
(assert_return (invoke $bulk "i64_from_i64_zero_end") (i32.const 0))
(assert_trap (invoke $bulk "i32_fill_zero_bad") "out of bounds memory access")
(assert_trap (invoke $bulk "i32_init_source_zero_bad") "out of bounds memory access")
(assert_trap (invoke $bulk "i32_init_dropped_nonempty") "out of bounds memory access")
(assert_trap (invoke $bulk "i64_fill_zero_bad") "out of bounds memory access")
(assert_trap (invoke $bulk "i64_init_source_zero_bad") "out of bounds memory access")
(assert_trap (invoke $bulk "i64_init_dropped_nonempty") "out of bounds memory access")
(assert_trap (invoke $bulk "i32_from_i32_zero_bad_destination") "out of bounds memory access")
(assert_trap (invoke $bulk "i32_from_i32_zero_bad_source") "out of bounds memory access")
(assert_trap (invoke $bulk "i32_from_i64_zero_bad_destination") "out of bounds memory access")
(assert_trap (invoke $bulk "i32_from_i64_zero_bad_source") "out of bounds memory access")
(assert_trap (invoke $bulk "i64_from_i32_zero_bad_destination") "out of bounds memory access")
(assert_trap (invoke $bulk "i64_from_i32_zero_bad_source") "out of bounds memory access")
(assert_trap (invoke $bulk "i64_from_i64_zero_bad_destination") "out of bounds memory access")
(assert_trap (invoke $bulk "i64_from_i64_zero_bad_source") "out of bounds memory access")
(assert_invalid (module (memory i64 1) (data "a") (func i64.const 0 i32.const 0 i64.const 0 memory.init 0)) "type mismatch")
(assert_invalid (module (memory i64 1) (func i64.const 0 i64.const 7 i64.const 0 memory.fill)) "type mismatch")
(assert_invalid (module (memory 1) (memory i64 1) (func i64.const 0 i32.const 0 i64.const 0 memory.copy 1 0)) "type mismatch")
(assert_invalid (module (memory 1) (memory i64 1) (func i32.const 0 i64.const 0 i64.const 0 memory.copy 0 1)) "type mismatch")
(assert_invalid (module (memory i64 1) (func i64.const 0 i64.const 0 i32.const 0 memory.copy)) "type mismatch")
(assert_invalid (module (memory i64 1) (func f32.const 0 memory.fill)) "type mismatch")
(assert_invalid (module (memory i64 1) (func unreachable f32.const 0 memory.copy)) "type mismatch")
(assert_invalid (module (memory i64 1) (func unreachable memory.fill 1)) "type mismatch")
(assert_invalid (module (memory i64 1) (func data.drop 0)) "type mismatch")
(assert_invalid (module (memory i64 1) (data "a") (func unreachable memory.init 1)) "type mismatch")
