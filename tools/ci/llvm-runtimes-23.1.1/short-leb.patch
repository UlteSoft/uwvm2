+// Short LEBs dominate ordinary native CFI operands. Check each full byte
+// before access and leave the original bounded/error-reporting decoder intact
+// for longer, truncated and malformed expressions. No metadata is cached.
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((always_inline))
+#endif
+inline uint64_t LocalAddressSpace::getULEB128(pint_t &addr, pint_t end) {
+  if (addr < end) {
+    const uint8_t first = *reinterpret_cast<uint8_t const *>(addr);
+    if (first < 0x80) { ++addr; return first; }
+    if (end - addr >= 2) {
+      const uint8_t second = *reinterpret_cast<uint8_t const *>(addr + 1);
+      if (second < 0x80) {
+        addr += 2;
+        return uint64_t(first & 0x7f) | (uint64_t(second) << 7);
+      }
+    }
+  }
+  return getULEB128Slow(addr, end);
+}
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((always_inline))
+#endif
+inline int64_t LocalAddressSpace::getSLEB128(pint_t &addr, pint_t end) {
+  if (addr < end) {
+    const uint8_t first = *reinterpret_cast<uint8_t const *>(addr);
+    if (first < 0x80) { ++addr; return (int64_t(first) ^ 0x40) - 0x40; }
+    if (end - addr >= 2) {
+      const uint8_t second = *reinterpret_cast<uint8_t const *>(addr + 1);
+      if (second < 0x80) {
+        addr += 2;
+        const int64_t bits = int64_t(first & 0x7f) | (int64_t(second) << 7);
+        return (bits ^ 0x2000) - 0x2000;
+      }
+    }
+  }
+  return getSLEB128Slow(addr, end);
+}
